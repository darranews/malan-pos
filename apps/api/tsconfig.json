{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2020",
    "outDir": "dist",
    "esModuleInterop": true,
    "skipLibCheck": true,

    // 👇 QUAN TRỌNG: dùng legacy decorators cho Nest
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,

    "types": ["node"]
  },
  "include": ["src/**/*"]
}
